{
  "name": "orbitchat",
  "version": "1.3.5",
  "private": true,
  "author": "OrbitChat Project",
  "description": "Orbit Chat desktop communication client with an embedded backend",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n WEB,TS,APP -c cyan,magenta,green \"vite --host 127.0.0.1\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 dist-electron/main/index.js && electron .\"",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.server.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "electron .",
    "server": "tsx server/src/index.ts",
    "test": "tsx --test server/test/*.test.ts tests/*.test.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "build:portable": "npm run build && electron-builder --win --x64 --dir",
    "zip:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable-zip.ps1",
    "installer:online": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/OfflineInstaller/build-online-installer.ps1",
    "installer:updater": "powershell -NoProfile -ExecutionPolicy Bypass -File installer/Updater/build-updater.ps1",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "emoji-picker-react": "^5.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "lucide-react": "^1.56.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "sql.js": "^1.14.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.orbitlabs.orbitchat",
    "productName": "Orbit Chat",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "server/dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraMetadata": {
      "main": "dist-electron/main/index.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Orbit-Chat-Setup-x64.exe"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "Orbit Chat",
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    }
  }
}
