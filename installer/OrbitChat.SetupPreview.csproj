<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OrbitChat.SetupPreview</AssemblyName>
    <RootNamespace>OrbitChat.SetupPreview</RootNamespace>
    <ApplicationIcon>..\build\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\build\icon.ico" Link="Assets\OrbitChat.ico" />
  </ItemGroup>
</Project>