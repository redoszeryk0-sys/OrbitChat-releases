<Application x:Class="OrbitChat.Updater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#17151E" />
    <SolidColorBrush x:Key="PanelBrush" Color="#211F29" />
    <SolidColorBrush x:Key="LineBrush" Color="#393546" />
    <SolidColorBrush x:Key="TextBrush" Color="#EEEAF7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A9A3B8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8D7CDA" />
    <SolidColorBrush x:Key="GreenBrush" Color="#51C78B" />
    <SolidColorBrush x:Key="RedBrush" Color="#ED6974" />
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="15,0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#796BC0" />
      <Setter Property="BorderBrush" Value="#9B8DE1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#887AD1" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.48" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#D2CCDF" />
      <Setter Property="Background" Value="#2A2734" />
      <Setter Property="BorderBrush" Value="#484355" />
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Foreground" Value="#A9A4B5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#302D38" /><Setter Property="Foreground" Value="White" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#716D7A" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
