<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName Condition="'$(MaintenanceBuild)' != 'true'">OrbitChat.OnlineInstaller</AssemblyName>
    <AssemblyName Condition="'$(MaintenanceBuild)' == 'true'">uninstall_orbitchat</AssemblyName>
    <AssemblyTitle Condition="'$(MaintenanceBuild)' != 'true'">Orbit Chat Online Installer</AssemblyTitle>
    <AssemblyTitle Condition="'$(MaintenanceBuild)' == 'true'">Orbit Chat Uninstaller</AssemblyTitle>
    <RootNamespace>OrbitChat.SetupPreview</RootNamespace>
    <ApplicationIcon>..\..\build\icon.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product Condition="'$(MaintenanceBuild)' != 'true'">Orbit Chat Online Installer</Product>
    <Product Condition="'$(MaintenanceBuild)' == 'true'">Orbit Chat Uninstaller</Product>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <IncludeAppPayload>false</IncludeAppPayload>
    <PublishDir Condition="'$(MaintenanceBuild)' == 'true'">$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\maintenance\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\build\icon.ico" Link="Assets\OrbitChat.ico" />
  </ItemGroup>
</Project>
