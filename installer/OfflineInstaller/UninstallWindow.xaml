<Window x:Class="OrbitChat.SetupPreview.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbit Chat Uninstaller" Width="620" Height="700"
        MinWidth="620" MaxWidth="620" MinHeight="700" MaxHeight="700"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" Icon="pack://application:,,,/Assets/OrbitChat.ico"
        Closing="Window_Closing">
  <Window.Resources>
    <Storyboard x:Key="SlideForward">
      <DoubleAnimation Storyboard.TargetName="StepPanel" Storyboard.TargetProperty="Opacity"
                       From="0" To="1" Duration="0:0:0.22" />
      <DoubleAnimation Storyboard.TargetName="StepSlide" Storyboard.TargetProperty="X"
                       From="24" To="0" Duration="0:0:0.28">
        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#D8D4E2" />
      <Setter Property="Background" Value="#292632" />
      <Setter Property="BorderBrush" Value="#393544" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#353240" /><Setter TargetName="Surface" Property="BorderBrush" Value="#504A60" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="MinWidth" Value="152" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#655A9D" />
      <Setter Property="BorderBrush" Value="#7C70B7" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#776BB0" /><Setter Property="BorderBrush" Value="#998DD1" /></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border Background="#14131A" BorderBrush="#302D3A" BorderThickness="1" CornerRadius="13" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="94" /><RowDefinition Height="*" /><RowDefinition Height="78" /></Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#17151E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /></Grid.ColumnDefinitions>
        <Image Source="pack://application:,,,/Assets/OrbitChat.ico" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="BrandName" Text="Orbit Chat" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="  /  Uninstall" Foreground="#8E899B" FontSize="12" />
        </StackPanel>
        <Border Grid.Column="2" Margin="0,0,11,0" Padding="9,4" CornerRadius="10" Background="#292336" BorderBrush="#443A61" BorderThickness="1" VerticalAlignment="Center">
          <TextBlock Text="APP REMOVAL" Foreground="#B1A6EB" FontSize="9" FontWeight="SemiBold" />
        </Border>
        <Button Grid.Column="3" Content="—" FontSize="17" Foreground="#A9A4B5" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" ToolTip="Minimize" />
        <Button x:Name="CloseButton" Grid.Column="4" Content="×" FontSize="19" Foreground="#A9A4B5" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" ToolTip="Close uninstaller" />
      </Grid>

      <Border Grid.Row="1" Background="#191720" BorderBrush="#302D3A" BorderThickness="0,0,0,1" Padding="23,13,22,9">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="39" /><RowDefinition Height="18" /></Grid.RowDefinitions>
          <Canvas x:Name="StepLineCanvas" Height="1" VerticalAlignment="Center" Margin="25,0,25,0" Background="#393544">
            <Border x:Name="StepProgressLine" Width="0" Height="2" Background="#887BCF" />
          </Canvas>
          <UniformGrid Grid.Row="0" x:Name="StepTracker" Rows="1" IsHitTestVisible="False" />
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="StepLabel0" Grid.Column="0" Text="Welcome" FontSize="8" HorizontalAlignment="Center" Foreground="#777282" />
            <TextBlock x:Name="StepLabel1" Grid.Column="1" Text="Review" FontSize="8" HorizontalAlignment="Center" Foreground="#777282" />
            <TextBlock x:Name="StepLabel2" Grid.Column="2" Text="Remove" FontSize="8" HorizontalAlignment="Center" Foreground="#777282" />
            <TextBlock x:Name="StepLabel3" Grid.Column="3" Text="Done" FontSize="8" HorizontalAlignment="Center" Foreground="#777282" />
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="2" ClipToBounds="True" Margin="28,25,28,15">
        <StackPanel x:Name="StepPanel" Opacity="1">
          <StackPanel.RenderTransform><TranslateTransform x:Name="StepSlide" X="0" /></StackPanel.RenderTransform>

          <StackPanel x:Name="WelcomeStep">
            <TextBlock Text="Removing this app?" FontSize="23" FontWeight="SemiBold" LineHeight="30" TextWrapping="Wrap" />
            <TextBlock x:Name="WelcomeDescription" Margin="0,8,0,20" FontSize="12" Foreground="#908B9D" LineHeight="19" TextWrapping="Wrap" />
            <Border Background="#1B1922" BorderBrush="#302D3A" BorderThickness="1" CornerRadius="11" Padding="15,13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="#302B40" BorderBrush="#49415F" BorderThickness="1" VerticalAlignment="Center">
                  <Image Source="pack://application:,,,/Assets/OrbitChat.ico" Width="26" Height="26" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                  <TextBlock x:Name="ProductNameText" Text="Orbit Chat" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock x:Name="ProductVersionText" Text="Version 1.2.0" Margin="0,3,0,0" FontSize="10" Foreground="#908B9D" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Background="#211D2D" BorderBrush="#383049" BorderThickness="1" CornerRadius="9" Padding="12,11" Margin="0,18,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="#887BCF" CornerRadius="3" />
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="Your account data stays" FontSize="11" FontWeight="SemiBold" Foreground="#EEEFF4" />
                  <TextBlock Text="Uninstalling removes the app files and shortcuts, not your account data, messages, or settings." Margin="0,3,0,0" FontSize="10" Foreground="#BAB3CC" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ReviewStep" Visibility="Collapsed">
            <TextBlock Text="Review before removing." FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Only the application files and its shortcuts will be removed." FontSize="12" Foreground="#908B9D" Margin="0,7,0,18" TextWrapping="Wrap" />
            <Border Background="#1B1922" BorderBrush="#302D3A" BorderThickness="1" CornerRadius="10" Padding="16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="APP" FontSize="9" Foreground="#908B9D" />
                <TextBlock x:Name="ReviewProduct" Grid.Column="1" Text="Orbit Chat" FontSize="11" FontWeight="SemiBold" />
                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#302D3A" Margin="0,12,0,12" />
                <TextBlock Grid.Row="2" Text="INSTALL LOCATION" FontSize="9" Foreground="#908B9D" />
                <TextBlock x:Name="ReviewPath" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontSize="10" Foreground="#D0CBD8" />
                <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" Background="#302D3A" Margin="0,12,0,12" />
                <TextBlock Grid.Row="4" Text="ACCOUNT DATA" FontSize="9" Foreground="#908B9D" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="Kept on this PC" FontSize="10" Foreground="#9ED7B8" />
              </Grid>
            </Border>
            <CheckBox x:Name="ConfirmRemoval" Content="I understand this removes the app files and shortcuts." Margin="2,18,0,0" Foreground="#C1BDCE" FontSize="11" Checked="ConfirmRemoval_Changed" Unchecked="ConfirmRemoval_Changed" />
            <TextBlock x:Name="UninstallError" Visibility="Collapsed" Margin="1,12,0,0" Foreground="#F08F99" FontSize="10" TextWrapping="Wrap" />
            <Border Background="#211D2D" BorderBrush="#383049" BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,15,0,0">
              <TextBlock Text="Your account data, messages, and settings are kept in your Windows profile." Foreground="#BAB3CC" FontSize="10" TextWrapping="Wrap" LineHeight="15" />
            </Border>
          </StackPanel>

          <StackPanel x:Name="ProgressStep" Visibility="Collapsed">
            <TextBlock x:Name="ProgressHeading" Text="Removing Orbit Chat." FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Removing the app registration and shortcuts. App data is left untouched." Margin="0,8,0,21" FontSize="12" Foreground="#908B9D" LineHeight="19" TextWrapping="Wrap" />
            <Border Background="#1B1922" BorderBrush="#302D3A" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15">
              <StackPanel>
                <Grid Margin="0,0,0,9">
                  <TextBlock x:Name="ProgressCaption" Text="Preparing removal…" FontSize="10" Foreground="#D8D4E2" />
                  <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="10" Foreground="#B1A6EB" HorizontalAlignment="Right" />
                </Grid>
                <Border x:Name="ProgressTrack" Height="6" Background="#302D3A" CornerRadius="4" ClipToBounds="True">
                  <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" Background="#887BCF" CornerRadius="4" />
                </Border>
                <TextBlock x:Name="ProgressDetail" Text="Checking the app installation." Margin="0,8,0,0" FontSize="9" Foreground="#908B9D" />
              </StackPanel>
            </Border>
            <TextBlock Text="REMOVAL PROGRESS" FontSize="9" FontWeight="SemiBold" Foreground="#908B9D" Margin="1,2,0,9" />
            <Border Background="#1B1922" BorderBrush="#302D3A" BorderThickness="1" CornerRadius="10" Padding="13,8">
              <StackPanel>
                <TextBlock x:Name="ProgressLineOne" Text="○   Check app files" Margin="0,7" FontSize="11" Foreground="#777282" />
                <TextBlock x:Name="ProgressLineTwo" Text="○   Remove shortcuts and app entry" Margin="0,7" FontSize="11" Foreground="#777282" />
                <TextBlock x:Name="ProgressLineThree" Text="○   Finish cleanup" Margin="0,7" FontSize="11" Foreground="#777282" />
              </StackPanel>
            </Border>
            <Border Background="#252232" BorderBrush="#403952" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,13,0,0">
              <TextBlock Text="The installer will finish deleting its own files after this window closes." FontSize="10" Foreground="#C1BDCE" TextWrapping="Wrap" />
            </Border>
          </StackPanel>

          <StackPanel x:Name="DoneStep" Visibility="Collapsed">
            <Border Width="54" Height="54" CornerRadius="18" Background="#1F302A" BorderBrush="#365844" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,17">
              <TextBlock Text="✓" FontSize="28" Foreground="#76D6A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="The app is removed." FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="DoneDescription" Text="The app files and shortcuts have been removed." Margin="0,8,0,19" FontSize="12" Foreground="#908B9D" TextWrapping="Wrap" />
            <Border Background="#1B1922" BorderBrush="#302D3A" BorderThickness="1" CornerRadius="10" Padding="15">
              <StackPanel>
                <TextBlock x:Name="DoneProduct" Text="Orbit Chat" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Account data, messages, and settings were kept." Margin="0,5,0,0" FontSize="10" Foreground="#9ED7B8" />
              </StackPanel>
            </Border>
            <Border Background="#252232" BorderBrush="#403952" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,16,0,0">
              <TextBlock Text="This removal did not connect to the internet or contact GitHub." FontSize="10" Foreground="#C1BDCE" TextWrapping="Wrap" LineHeight="16" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border Grid.Row="3" Background="#191720" BorderBrush="#302D3A" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="22,11">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Uninstaller · app removal only." FontSize="10" Foreground="#ABA6B5" />
            <TextBlock Text="Your Orbit Chat account data stays on this PC." Margin="0,3,0,0" FontSize="9" Foreground="#706B7B" />
          </StackPanel>
          <Button x:Name="BackButton" Grid.Column="1" Content="←  Back" Style="{StaticResource ActionButton}" Click="BackButton_Click" />
          <Button x:Name="NextButton" Grid.Column="3" Content="Next  →" Style="{StaticResource PrimaryButton}" Click="NextButton_Click" IsEnabled="True" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
