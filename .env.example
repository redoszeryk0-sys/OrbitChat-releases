# Optional server-side configuration
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data_server
UPLOAD_DIR=./data_server/uploads
MAX_UPLOAD_MB=20480
CORS_ORIGINS=null,http://127.0.0.1:5173
# Playit TCP endpoint. For the Debian manager defaults these are saved in server-config/server.env.
PLAYIT_PUBLIC_HOST=orbit-chat-europe.playit.plus
PLAYIT_PUBLIC_PORT=52152
# Optional Tenor API key. Configure on the backend only; never ship it in the desktop client.
TENOR_API_KEY=
# Public HTTPS URL to a TURN service for reliable voice calls across restrictive networks.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
